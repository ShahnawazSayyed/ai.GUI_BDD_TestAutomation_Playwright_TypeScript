{
  "name": "ai.gui_bdd_testautomation_playwright_typescript",
  "version": "1.0.0",
  "description": "GUI Automation Framework using Playwright TypeScript",
  "homepage": "https://github.com/ShahnawazSayyed/ai.GUI_BDD_TestAutomation_Playwright_TypeScript#readme",
  "bugs": {
    "url": "https://github.com/ShahnawazSayyed/ai.GUI_BDD_TestAutomation_Playwright_TypeScript/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ShahnawazSayyed/ai.GUI_BDD_TestAutomation_Playwright_TypeScript.git"
  },
  "license": "ISC",
  "author": "",
  "engines": {
    "node": "22 || 24 || >=26"
  },
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:ui": "playwright test --config=playwright/config/playwright.config.ts",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:report": "cucumber-js --format html:test-results/cucumber-report.html",
    "test:parallel": "cucumber-js --parallel 4",
    "test:parallel:headed": "cross-env HEADLESS=false cucumber-js --parallel 4",
    "test:chromium": "cross-env BROWSER=chromium cucumber-js --parallel 4",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js --parallel 4",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js --parallel 4",
    "test:browsers": "node utilities/runCucumberBrowsers.js",
    "test:ui:parallel": "playwright test --config=playwright/config/playwright.config.ts",
    "test:ui:chromium": "playwright test --config=playwright/config/playwright.config.ts --project=chromium",
    "test:ui:firefox": "cross-env BROWSERS=firefox playwright test --config=playwright/config/playwright.config.ts --project=firefox",
    "test:ui:webkit": "cross-env BROWSERS=webkit playwright test --config=playwright/config/playwright.config.ts --project=webkit",
    "test:ui:all": "cross-env BROWSERS=chromium,firefox,webkit playwright test --config=playwright/config/playwright.config.ts",
    "test:ci:cucumber": "node cicd/run-tests.js cucumber",
    "test:ci:playwright": "node cicd/run-tests.js playwright",
    "test:ci:unit": "node --test cicd/tests/unit-quality-gates.test.js",
    "test:ci:integration": "node cicd/tests/integration-quality-gates.js",
    "test:ci:quality-gates": "npm run test:ci:unit && npm run test:ci:integration",
    "test:discover": "node utilities/testDiscovery.js",
    "test:impact": "node utilities/testImpactAnalysis.js",
    "test:diagnose": "node utilities/testFailureDiagnosis.js",
    "test:heal-locators": "node utilities/selfHealingLocator.js",
    "test:coverage-gaps": "node utilities/testCoverageGaps.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "playwright": "^1.64.1"
  }
}
